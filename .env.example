# .env.example - contains no real credentials.
# Copy this file to ".env" (which is git-ignored) and fill in your own key.

# Provider: gemini (default) | openai | groq | openrouter | ollama
LLM_PROVIDER=gemini

# Your API key. Free Gemini keys: https://aistudio.google.com/apikey
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Model name. Must be vision-capable for meal photo analysis (F02).
LLM_MODEL=gemini-flash-lite-latest

# Optional overrides
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_TIMEOUT_SECONDS=45
# PULSEFORGE_DATA_DIR=data

# Example: free local model through Ollama (no key needed)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2-vision
